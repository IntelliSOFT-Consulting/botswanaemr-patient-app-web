# Botswana EMR Backend - unified environment variables
# Copy to .env and fill in values. See SETUP.md.
SPRING_PROFILES_ACTIVE=server
OPENMRS_USERNAME=your-openmrs-username
OPENMRS_PASSWORD=your-openmrs-password
OPENMRS_URL=https://your-openmrs-instance/openmrs/ws/rest/
OPENMRS_TIMESLOTS=https://your-openmrs-instance/openmrs/ws/rest/v1/appointmentscheduling/timeslot?v=default
OPENMRS_TYPES=https://your-openmrs-instance/openmrs/ws/rest/v1/appointmentscheduling/appointmenttype?v=default
OPENMRS_BOOK=https://your-openmrs-instance/openmrs/ws/rest/v1/appointmentscheduling/appointmentallowingoverbook
OPENMRS_SLOT=https://your-openmrs-instance/openmrs/ws/rest/v1/appointmentscheduling/timeslot/
OPENMRS_APPOINTMENT=https://your-openmrs-instance/openmrs/ws/rest/v1/appointmentscheduling/appointmentrequest
OPENMRS_SCHEDULE=https://your-openmrs-instance/openmrs/ws/rest/v1/appointmentscheduling/appointment
OPENMRS_APPS=https://your-openmrs-instance/openmrs/ws/rest/v1/appointmentscheduling/appointment?v=default
OPENMRS_VISITS=https://your-openmrs-instance/openmrs/ws/rest/v1/visit?v=full
KEYCLOAK_AUTH_SERVER_URL=http://keycloak:8080/
KEYCLOAK_RESOURCE=botswana-emr
KEYCLOAK_REALM=botswana-emr-realm
KEYCLOAK_PUBLIC_CLIENT=true
KEYCLOAK_SSL_REQUIRED=external
KEYCLOAK_USE_RESOURCE_ROLE_MAPPINGS=true
KEYCLOAK_BEARER_ONLY=true
KEYCLOAK_DISABLE_TRUST_MANAGER=true
KEYCLOAK_CONFIDENTIAL_PORT=443
APP_KEYCLOAK_GRANT_TYPE=password
APP_KEYCLOAK_SCOPE=openid, profile
APP_KEYCLOAK_CLIENT_ID=botswana-emr
APP_KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret
APP_KEYCLOAK_AUTH_SERVER_URL=http://keycloak:8080/
APP_KEYCLOAK_REFRESH=/realms/botswana-emr-realm/protocol/openid-connect/token
APP_KEYCLOAK_REALM_USERNAME=admin
APP_KEYCLOAK_REALM_PASSWORD=your-keycloak-admin-password
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-mail-username
SPRING_MAIL_PASSWORD=your-mail-app-password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host:5432/your-database
SPRING_DATASOURCE_USERNAME=your-db-username
SPRING_DATASOURCE_PASSWORD=your-db-password
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
AUTHENTICATION_SERVICE_URL=http://authservice:8081/auths
NOTIFICATION_SERVICE_URL=http://notificationservice:7001/notification
FILE_UPLOAD_DIR=/var/www/upload/
FILE_STORAGE_SERVER_PORT=7003
SPRING_SERVLET_MULTIPART_ENABLED=true
SPRING_SERVLET_MULTIPART_FILE_SIZE_THRESHOLD=2KB
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=1000MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=125MB
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_ARTICLES_CLIENT_OIDC_CLIENT_ID=appointments-client
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_SPRING_ISSUER_URI=http://localhost:8083
SPRING_CODEC_MAX_IN_MEMORY_SIZE=100MB
SPRING_MVC_PATHMATCH_MATCHING_STRATEGY=ant_path_matcher
SERVER_PORT=8081
SPRING_APPLICATION_NAME=botswana-emr-auth
SERVER_ERROR_INCLUDE_MESSAGE=always
